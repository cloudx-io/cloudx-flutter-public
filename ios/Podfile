# Flutter 3.47 ships an engine with a 15.0 deployment floor; CloudXCore itself supports 13.0.
platform :ios, '15.0'

# CocoaPods analytics sends network stats synchronously affecting flutter build latency.
ENV['COCOAPODS_DISABLE_STATS'] = 'true'

project 'Runner', {
  'Debug' => :debug,
  'Profile' => :release,
  'Release' => :release,
}

def flutter_root
  generated_xcode_build_settings_path = File.expand_path(File.join('..', 'Flutter', 'Generated.xcconfig'), __FILE__)
  unless File.exist?(generated_xcode_build_settings_path)
    raise "#{generated_xcode_build_settings_path} must exist. If you're running pod install manually, make sure flutter pub get is executed first"
  end

  File.foreach(generated_xcode_build_settings_path) do |line|
    matches = line.match(/FLUTTER_ROOT\=(.*)/)
    return matches[1].strip if matches
  end
  raise "FLUTTER_ROOT not found in #{generated_xcode_build_settings_path}. Try deleting Generated.xcconfig, then run flutter pub get"
end

require File.expand_path(File.join('packages', 'flutter_tools', 'bin', 'podhelper'), flutter_root)

flutter_ios_podfile_setup

target 'Runner' do
  use_frameworks! :linkage => :static
  use_modular_headers!

  flutter_install_all_ios_pods File.dirname(File.realpath(__FILE__))

  # CloudX SDK and adapters. Adapters version independently of CloudXCore, on a
  # <network-sdk-version>.<adapter-revision> scheme. Take only the networks your
  # dashboard actually serves.
  #
  # CloudXGoogleWaterfallAdapter is deliberately absent. It runs AdMob demand
  # INSIDE the CloudX auction, which is the opposite of what this demo shows:
  # here AdMob is an external bid competing against CloudX through the arbiter.
  # Shipping both would make the two bids the same demand. Leaving it out also
  # frees google_mobile_ads from having to match that adapter's exact
  # Google-Mobile-Ads-SDK pin, which is why this app can be on the current
  # google_mobile_ads release.
  #
  # CloudXCore is deliberately not declared here. The cloudx_flutter podspec
  # already pins it, so the core follows the plugin and there is no second
  # place to update. Declaring it again would only create a conflict: the
  # previous '~> 3.9.0' here meant '>= 3.9.0, < 3.10.0', which the 3.10.0
  # plugin's own '~> 3.10.0' cannot satisfy.
  #
  # Each adapter is declared by major version with the optimistic operator, so
  # the demo resolves the newest release on that line instead of going stale
  # between CloudX releases. '~> 7.0' is '>= 7.0, < 8.0'. Note that two
  # components are what makes it a major-version range: a four-component
  # '~> 7.7.6.0' is '>= 7.7.6.0, < 7.7.7.0', a patch lock that only looks
  # like one.
  #
  # CloudXBigoAdapter is absent for a Flutter-specific reason, not because it
  # does not exist. With that pod installed, the Flutter tool writes
  # EXCLUDED_ARCHS[sdk=iphonesimulator*] into Flutter/Generated.xcconfig, the
  # Runner is then built x86_64 only, and an Apple Silicon simulator refuses to
  # install it. This demo has to run as-is on `flutter run`, so it stays out;
  # test BIGO on a physical device.
  pod 'CloudXMetaAdapter', '~> 6.0'
  pod 'CloudXVungleAdapter', '~> 7.0'
  pod 'CloudXInMobiAdapter', '~> 11.0'
  pod 'CloudXMintegralAdapter', '~> 8.0'
  pod 'CloudXUnityAdsAdapter', '~> 4.0'
  pod 'CloudXMagniteAdapterV2', '~> 1.0'
  pod 'CloudXMobileFuseAdapter', '~> 1.0'
  pod 'CloudXMolocoAdapter', '~> 4.0'
  pod 'CloudXVerveAdapter', '~> 3.0'
  pod 'CloudXDigitalTurbineAdapter', '~> 8.0'
  pod 'CloudXPangleAdapter', '~> 8.0'
  pod 'CloudXTaurusXAdapter', '~> 1.0'

  target 'RunnerTests' do
    inherit! :search_paths
  end
end

post_install do |installer|
  installer.pods_project.targets.each do |target|
    flutter_additional_ios_build_settings(target)

    target.build_configurations.each do |config|
      config.build_settings['IPHONEOS_DEPLOYMENT_TARGET'] = '15.0'
    end
  end
end
