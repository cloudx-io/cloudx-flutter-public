# Symbolication related
app.*.symbols

# Obfuscation related
app.*.map.json

# Android Studio will place build artifacts here
/android/app/debug
/android/app/profile
/android/app/release

# Widget Preview related
.widget_preview/

# No lockfile is committed. A committed lock replays the resolution it recorded,
# which would hold the pub range in pubspec.yaml and the pod ranges in
# ios/Podfile where they were. Gradle resolves the `+` ranges in
# android/app/build.gradle.kts on each build and is not locked by either file.
# See the Versions section of README.md.
pubspec.lock
ios/Podfile.lock
